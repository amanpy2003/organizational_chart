# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Any http://localhost:<port> or http://127.0.0.1:<port> is also allowed by
# default (see app/config/settings.py CORS_ORIGIN_REGEX) as a safety net in
# case the frontend ends up on a different port than usual — override this
# if you need to lock it down further.
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):\d+$

# Max upload size in megabytes
MAX_UPLOAD_MB=15

# Max employees accepted in a single upload (safety limit)
MAX_EMPLOYEES=5000
